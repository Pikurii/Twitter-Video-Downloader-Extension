{
  "manifest_version": 3,
  "name": "X-Vault",
  "version": "2.2.0",
  "description": "Fast, ad-free media downloader for Twitter / X. Save HD videos, GIF animations, photos, and MP3 audio.",
  "author": "Pikuri (https://github.com/Pikurii)",
  "homepage_url": "https://github.com/Pikurii",
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-vault-downloader@pikuri.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X-Vault"
  },
  "options_page": "settings/settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["lame.min.js", "modules/gifEncoder.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["twitter_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "notifications",
    "webRequest",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://*.twimg.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "twitter_interceptor.js",
        "settings/settings.html"
      ],
      "matches": [
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://x.com/*",
        "*://*.x.com/*"
      ]
    }
  ]
}
